# Copy this file to .env and fill in real values locally.
# NEVER commit .env, and never put real secrets in this file.

# --- MetaTrader 5 (used starting Phase 6) ---
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_PATH=

# --- Telegram alerting (used starting Phase 7) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Data Infrastructure (Phase 1) ---
# Not credentials: local filesystem paths and timezone/config values only.
# MT5_TERMINAL_PATH: optional path to terminal64.exe, if not on the default
#   install location. The data layer connects to an already-running,
#   already-logged-in terminal and never supplies broker credentials.
MT5_TERMINAL_PATH=
# MT5_BROKER_TIMEZONE: IANA timezone name your broker's MT5 server uses for
#   bar timestamps (e.g. "Europe/Athens"). Must be set correctly for
#   accurate UTC normalization; defaults to UTC if unset.
MT5_BROKER_TIMEZONE=UTC
DATA_RAW_DIR=data/raw
DATA_NORMALIZED_DIR=data/normalized
DATA_METADATA_DIR=data/metadata

# --- Application ---
LOG_LEVEL=INFO
ENVIRONMENT=research
